{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-halo.invalid/protocol/v1/event-detail",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "summary",
    "approvalId",
    "approvalContextDigest",
    "toolName",
    "toolInputText",
    "description",
    "options",
    "questions",
    "truncated",
    "redacted",
    "remoteActionable",
    "pcTime"
  ],
  "properties": {
    "persistentPreviews": { "type": "object", "maxProperties": 12, "propertyNames": { "type": "string", "pattern": "^(always|suggestion:[0-9]+)$" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 16000 } },
    "protocolVersion": {
      "const": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "eventId",
        "pcId",
        "pcSessionEpoch",
        "streamSeq",
        "eventRevision",
        "kind",
        "agentId",
        "createdAt",
        "expiresAt",
        "state",
        "actionable",
        "pendingCount",
        "summaryKey"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "pcId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "pcSessionEpoch": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "streamSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "eventRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "approval",
            "question",
            "input",
            "plan",
            "completion"
          ]
        },
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "createdAt": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "expiresAt": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "state": {
          "enum": [
            "pending",
            "resolved",
            "expired",
            "disconnected"
          ]
        },
        "actionable": {
          "type": "boolean"
        },
        "pendingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "summaryKey": {
          "enum": [
            "remote.approvalRequested",
            "remote.questionRequested",
            "remote.inputRequested",
            "remote.planReady",
            "remote.completed"
          ]
        }
      }
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "approvalContextDigest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "toolName": {
      "type": "string",
      "minLength": 0,
      "maxLength": 160
    },
    "toolInputText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 65536
    },
    "description": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1000
    },
    "options": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "labelKey",
          "tone"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^(allow|deny|native|once|reject|always|submit|suggestion:[0-9]+)$"
          },
          "label": {
            "type": "string",
            "minLength": 0,
            "maxLength": 160
          },
          "labelKey": {
            "type": "string",
            "minLength": 0,
            "maxLength": 120
          },
          "tone": {
            "enum": [
              "primary",
              "danger",
              "secondary"
            ]
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "header",
          "question",
          "questionKey",
          "multiSelect",
          "allowText",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "header": {
            "type": "string",
            "minLength": 0,
            "maxLength": 120
          },
          "question": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "questionKey": {
            "type": "string",
            "minLength": 0,
            "maxLength": 120
          },
          "multiSelect": {
            "type": "boolean"
          },
          "allowText": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "description": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 600
                }
              }
            }
          }
        }
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "redacted": {
      "type": "boolean"
    },
    "remoteActionable": {
      "type": "boolean"
    },
    "pcTime": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
