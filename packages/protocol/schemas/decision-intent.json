{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-halo.invalid/protocol/v1/decision-intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "decisionId",
    "bindingId",
    "bindingRevision",
    "mobileId",
    "pcId",
    "pcSessionEpoch",
    "eventId",
    "approvalId",
    "expectedRevision",
    "approvalContextDigest",
    "optionId",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "decisionId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "bindingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "bindingRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "mobileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "pcId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "pcSessionEpoch": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "approvalContextDigest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "optionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(allow|deny|native|once|reject|always|submit|suggestion:[0-9]+)$"
    },
    "issuedAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expiresAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "answers": {
      "type": "object",
      "maxProperties": 10,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "not": {
          "enum": [
            "__proto__",
            "prototype",
            "constructor"
          ]
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "minItems": 1
          }
        ]
      }
    }
  }
}
